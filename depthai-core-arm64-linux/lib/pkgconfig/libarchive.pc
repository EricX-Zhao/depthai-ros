prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.7.7

Libs: "-L${libdir}" -larchive
Requires: liblzma
Cflags: "-I${includedir}" -DLIBARCHIVE_STATIC
